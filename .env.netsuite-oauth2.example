# Copy to .env.netsuite-oauth2 and fill in real values.
# This file is for the OAuth 2.0 M2M debug script:
#   env $(grep -v '^#' .env.netsuite-oauth2 | xargs) npx tsx scripts/test-netsuite-oauth2.ts

# Account ID (underscore form for sandbox, e.g. 4325477_SB1)
NS_ACCOUNT=4325477_SB1

# Client ID from the Integration record (Setup → Integration → Manage Integrations)
NS_CLIENT_ID=

# Certificate ID from Setup → Integration → OAuth 2.0 Client Credentials (M2M) Setup list
NS_CERTIFICATE_ID=

# Path to the private key PEM file (preferred over NS_PRIVATE_KEY)
NS_PRIVATE_KEY_FILE=./netsuite_private.pem

# Optional: public cert PEM path — lets the script recompute thumbprints
# and compare them to NS_CERTIFICATE_ID
NS_CERT_FILE=./netsuite_public.pem

# Optional: override scope. Default is "restlets".
# Use "restlets rest_webservices" only if both are checked on the Integration.
# NS_SCOPE=restlets

# Optional: override the JWT aud claim for experimentation
# NS_AUD_OVERRIDE=
